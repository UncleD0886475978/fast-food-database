# fast-food-database (QuickBite) configuration — copy to .env (./setup.sh does this for you)
# CHANGE ME: these are safe local-dev defaults, not production secrets.
# Note: DB_USER becomes MongoDB's admin (root) user, auth database "admin".
DB_NAME=quickbite
DB_USER=quickbite
DB_PASSWORD=quickbite_change_me
DB_PORT=27017
